<Window x:Class="PasswordManager.SelectFileLocation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Select File Location" Height="150" Width="500">
    <Grid>
        <Label x:Name="label" Content="Password File Location:" HorizontalAlignment="Left" Height="25" Margin="10,14,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="filePathTextBox" HorizontalAlignment="Left" Height="25" Margin="10,45,0,0" TextWrapping="Wrap" Text="..\\protectedPasswordFile.pw" VerticalAlignment="Top" Width="350"/>
        <Button x:Name="browseButton" Content="Browse" HorizontalAlignment="Left" Height="25" Margin="370,45,0,0" VerticalAlignment="Top" Width="100" Click="browseButton_Click"/>
        <Button x:Name="okButton" Content="OK" HorizontalAlignment="Right" Height="20" Margin="0,0,100,10" VerticalAlignment="Bottom" Width="85" Click="okButton_Click"/>
        <Button x:Name="cancelButton" Content="Cancel" HorizontalAlignment="Right" Height="20" Margin="0,0,10,10" VerticalAlignment="Bottom" Width="85" Click="cancelButton_Click"/>
    </Grid>
</Window>
